<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
xmlns="https://ejsto.github.io/CSE_445_Assignment_4/"
targetNamespace="https://ejsto.github.io/CSE_445_Assignment_4/" 
elementFormDefault="qualified" attributeFormDefault="unqualified">
  
  <!-- Root element: National Parks collection -->
  <xsd:element name="NationalParks">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="NationalPark" type="NationalParkType" maxOccurs="unbounded"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>

  <!-- National Park Type -->
  <xsd:complexType name="NationalParkType">
    <xsd:sequence>
      <xsd:element name="Name" type="xsd:string"/>
      <xsd:element name="Phone" type="PhoneType" maxOccurs="unbounded" minOccurs="1"/>
      <xsd:element name="Address" type="AddressType"/>
    </xsd:sequence>  
	  <xsd:attribute name="Rating" type="xsd:decimal" use="optional"/>
  </xsd:complexType>

  <!-- Address Type -->
  <xsd:complexType name="AddressType">
    <xsd:sequence>
      <xsd:element name="Number" type="xsd:string"/>
      <xsd:element name="Street" type="xsd:string"/>
      <xsd:element name="City" type="xsd:string"/>
      <xsd:element name="State" type="xsd:string"/>
      <xsd:element name="Zip" type="xsd:string"/>
    </xsd:sequence>  
	  <xsd:attribute name="NearestAirport" type="xsd:string" use="required"/>
  </xsd:complexType>
	
  <!-- Phone Type -->	
  <xsd:simpleType name="PhoneType">
    <xsd:restriction base="xsd:string">
      <xsd:pattern value="\(\d{3}\) \d{3}-\d{4}"/>
    </xsd:restriction>
  </xsd:simpleType>
</xsd:schema>
